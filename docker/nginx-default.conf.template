# 模板由 nginx 官方镜像启动时做 envsubst（仅替换已定义的环境变量，
# $host / $uri 等 nginx 变量不受影响），MC_API_BASE_URL 由容器环境注入。
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 压缩与缓存：JS/CSS 单 chunk 较大，gzip 显著减少传输；
    # /assets/* 为哈希文件名，可长期缓存
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 入口页与版本指纹不缓存：每次协商校验，部署新版本后 HTML 入口立即生效
    # （前端 versionCheck 靠拉 /version.json 发现新构建提示刷新）
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location = /version.json {
        add_header Cache-Control "no-cache";
    }

    # 后端反代：浏览器同源访问 /api，规避 CORS。
    # 变量 + Docker 内嵌 DNS（127.0.0.11）运行时解析：server 容器重建换 IP 后无需重启 web
    # （静态 proxy_pass 会在启动期解析并缓存，上游换 IP 即 502）
    location /api {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $mc_api_upstream "${MC_API_BASE_URL}";
        proxy_pass $mc_api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
    }

    # 飞牛（fnOS）音乐库反代（可选）：location 块由 40-generate-config.sh 按需
    # 生成到 /etc/nginx/mc-fnos/；通配 include 在无匹配文件时不报错
    include /etc/nginx/mc-fnos/*.conf;

    # SPA 兜底
    location / {
        try_files $uri $uri/ /index.html;
    }
}
