# MusicCopilot 部署配置模板（docker compose 读取；复制为 .env 后按需修改）
# 各变量详解见 docs/configuration.md；前端本地开发变量模板见 web/.env.example
# =============================================================================

# MusicCopilot 镜像 tag（可选：latest / development / v*）
MC_IMAGE_TAG=latest

# MusicCopilot WEB 对外端口
MC_WEB_PORT=17016

# SQLite 库落盘目录（可选，默认 ./data）
MC_SERVER_DATA_DIR=./data
# 音乐下载路径（可选，默认 ./downloads）
MC_MUSIC_DOWNLOAD_DIR=./downloads
# 音乐下载路径模板（可选，默认 {albumArtist}/{album}/{title} - {albumArtist}.{ext}）
#MC_MUSIC_DOWNLOAD_PATH_TEMPLATE={albumArtist}/{album}/{title} - {albumArtist}.{ext}

# 飞牛（fnOS）音乐库接入
# 可选；不配置则「音乐库」入口不显示。
# 凭据（USERNAME/PASSWORD）由 server 容器代持完成登录（/api/fnos/login），
# 不再经 config.json 下发浏览器；本地 dev 需将三者同步配到 server/.env
#MC_FNOS_BASE_URL=
#MC_FNOS_USERNAME=
#MC_FNOS_PASSWORD=
