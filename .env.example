# MusicCopilot 运行配置模板：复制为 .env 后按需修改（.env 已被 git 忽略）。
# 真实环境变量优先于本文件 —— Docker 部署用 -e 或 compose env_file 传入同名变量即可。

# SQ Music 后端地址（npm run dev / preview 与 Docker 部署必填）：
# 供服务端转发层使用 —— Vite 代理与容器内 nginx 共用；浏览器始终同源访问自身 /api。
# 注意：Docker 容器内 localhost 指向容器自身 —— 后端与 Docker 同机时用
# http://host.docker.internal:8096（compose 已配好 host-gateway 映射）或宿主机局域网 IP。
MC_API_BASE_URL=http://host.docker.internal:8096

# 自动登录账号（token 失效也会用它静默重登；留空则不自动登录，此时可在应用
# 设置面板按设备配置连接，仅存于该设备浏览器）。注意：密码避免包含双引号
# 或反斜杠（会破坏生成的 config.json / JSON 转义）。
MC_API_USERNAME=admin
MC_API_PASSWORD=admin

# 是否自动登录（true / false，默认 true）。
MC_AUTO_LOGIN=true

# 域名 / 反向代理访问 dev、preview 时放行的 Host（逗号分隔多个；Vite 默认仅放行 localhost）。
# 仅影响 Vite 开发服务器，与 Docker 部署无关（nginx 不做 Host 校验）。
#MC_ALLOWED_HOSTS=music-copilot.example.com

# ── 飞牛（fnOS）音乐库接入（可选；不配置则「音乐库」入口不显示）──
# fnOS 网关地址（Vite 代理与容器内 nginx 把 /fnos 反代到该地址，浏览器始终同源访问 /fnos）。
# Docker 内与 fnOS 同机时同样用 http://host.docker.internal:5666 或宿主机局域网 IP。
#MC_FNOS_BASE_URL=http://192.168.31.31:5666
# 飞牛登录账号（token 失效时用它静默重登；密码经 SHA-256 后提交，避免明文出现在请求日志）。
#MC_FNOS_USERNAME=
#MC_FNOS_PASSWORD=
# 是否自动登录飞牛音乐（true / false，默认 true）。
#MC_FNOS_AUTO_LOGIN=true

# ── 刮削工具接入（可选；不配置则「音乐库体检」入口不显示）──
# 独立刮削工具（仓库 scraper/ 目录构建的镜像）地址：Vite 代理与容器内 nginx 把
# /mc 反代到该地址；工具路由自带 /mc 前缀，转发时不剥前缀。
#MC_SCRAPER_BASE_URL=http://192.168.31.31:8098
# 刮削工具的共享 token（工具侧 MC_SCRAPER_TOKEN 非空时必填；前端以 x-mc-token 头携带）。
#MC_SCRAPER_TOKEN=
# server/ 下载完成后推送刮削通知（M4；容器部署时 scraper 与 server 同 compose 网络可直连）。
# 注意与上面的 MC_SCRAPER_BASE_URL 不同：这是 server 容器出站调用的地址。
#MC_SCRAPER_URL=http://music-copilot-scraper:8098/mc/api

# 端口：docker-compose.yml 的对外端口，同时是本地 npm run dev / preview 的服务器端口
# （未配置或非法值时 dev/preview 回退 5173；端口被占用自动 +1）
MC_PORT=17016

# 预构建镜像 tag（仅 docker-compose.yml 读取，默认 latest = v0.1.x 稳定线）。
# 跟随 development 分支预构建镜像时取消注释并改为 development；
# 跟当前工作区代码则 docker compose up -d --build，不必改此项。
#MC_IMAGE_TAG=latest

# ── 自建后端 server/（第 5 期；compose 的 server/scraper profile）──
# 启用：.env 加 COMPOSE_PROFILES=server,scraper 后 docker compose up -d
#COMPOSE_PROFILES=server,scraper
# 音乐库目录（宿主机绝对路径）：server 下载落盘 + scraper 体检/自动刮削共用，
# 即 fnOS「音乐」应用扫描的目录（原 SQMusic 下载目录）。
#MC_MUSIC_HOST_DIR=/vol1/@team/DockerSpace/simple-sq-music-plus/music
# server 对外端口与登录凭证（SQMusic 对齐契约：sqmusic 请求头）。
#MC_SERVER_PORT=8097
#MC_AUTH_USERNAME=admin
#MC_AUTH_PASSWORD=admin
# 前端 /mc 反代与 server 刮削通知的共享 token（scraper 侧同名变量；留空=内网不鉴权）
#MC_SCRAPER_TOKEN=
# scraper 镜像 tag（默认 latest）
#MC_SCRAPER_IMAGE_TAG=latest
# server 容器内下载目录（默认 /downloads，指向挂载的音乐库目录，一般无需改）
#MC_DOWNLOAD_DIR=/downloads
# Last.fm API key（流派补全优先源，免费申请 https://www.last.fm/api/account/create）；
# 留空则流派仅走 Deezer。两源大陆直连均不可达，不可达时静默跳过、需代理出口
#MC_LASTFM_API_KEY=
