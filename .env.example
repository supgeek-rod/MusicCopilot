# MusicCopilot 配置模板：复制为 .env 后按需修改；各变量详解见 docs/configuration.md
# =============================================================================

# MusicCopilot 镜像 tag（可选：latest / development / v*）
MC_IMAGE_TAG=latest

# MusicCopilot WEB 对外端口
MC_WEB_PORT=17016

# 后端地址仅本地开发（npm run dev / preview）使用
# Docker 部署忽略此变量（compose 固定反代到 server 容器）
# MC_API_BASE_URL=http://127.0.0.1:17017

MC_SERVER_DATA_DIR=./data                                                 # SQLite 库落盘目录
MC_MUSIC_DOWNLOAD_DIR=./downloads                                         # 音乐下载路径
#MC_MUSIC_DOWNLOAD_PATH_TEMPLATE={albumArtist}/{album}/{title} - {albumArtist}.{ext} # 音乐下载路径模板

# 飞牛（fnOS）音乐库认证配置
# 可选；不配置则「音乐库」入口不显示
#MC_FNOS_AUTO_LOGIN=true
#MC_FNOS_BASE_URL=
#MC_FNOS_USERNAME=
#MC_FNOS_PASSWORD=