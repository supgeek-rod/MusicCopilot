# MusicCopilot 配置模板：复制为 .env 后按需修改；各变量详解见 docs/configuration.md
# 后端地址仅本地开发（npm run dev / preview）使用；Docker 部署忽略此变量（compose 固定反代到 server 容器）
MC_API_BASE_URL=http://127.0.0.1:8097

# 自动登录账号（留空则不自动登录，可在应用设置面板按设备配置）
MC_API_USERNAME=admin
MC_API_PASSWORD=admin

# 是否自动登录（默认 true）
MC_AUTO_LOGIN=true

# Vite dev/preview 放行的 Host（逗号分隔；仅影响开发服务器，与 Docker 无关）
#MC_ALLOWED_HOSTS=music-copilot.example.com

# ── 飞牛（fnOS）音乐库接入（可选；不配置则「音乐库」入口不显示）──
#MC_FNOS_BASE_URL=http://192.168.31.31:5666
#MC_FNOS_USERNAME=
#MC_FNOS_PASSWORD=
#MC_FNOS_AUTO_LOGIN=true

# 对外端口（compose 与本地 dev/preview 共用，默认 17016）
MC_PORT=17016

# 镜像 tag（仅 compose 读取，默认 latest = v* 版本发布）
#MC_IMAGE_TAG=latest

# ── 自建后端 server/（默认值即可用）──
#MC_MUSIC_HOST_DIR=/vol1/1000/Musics/MusicCopilot
#MC_AUTH_USERNAME=admin
#MC_AUTH_PASSWORD=admin
#MC_DIR_TEMPLATE={albumArtist}/{album}/{title} - {albumArtist}.{ext}
