# MusicCopilot 前端（web/）本地开发配置模板：复制为 web/.env 后按需修改
# 各变量详解见 docs/configuration.md；Docker 部署变量模板见仓库根 .env.example
# =============================================================================

# 后端地址（dev/preview 必填：Vite 将 /api 反代到该地址，缺它 npm run dev 启动即失败）
MC_API_BASE_URL=http://127.0.0.1:17017

# 前端 dev/preview 端口（可选，默认 5173；与 Docker 对外端口共用变量名）
#MC_WEB_PORT=17016

# 反向代理 / 域名访问 dev、preview 时需放行的 Host（逗号分隔）
#MC_ALLOWED_HOSTS=

# 飞牛（fnOS）音乐库反代（可选）：/fnos/* → MC_FNOS_BASE_URL，不配置则「音乐库」入口不显示
# 凭据（USERNAME/PASSWORD）由 server 代持，仅配到 server/.env，前端不接触
#MC_FNOS_BASE_URL=
#MC_FNOS_AUTO_LOGIN=true
